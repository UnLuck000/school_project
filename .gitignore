# программы VPN (sing-box, Xray, Wintun, ~130 МБ) — в релиз отдельно; лицензии и
# vpn/bin/THIRD_PARTY.md (версии, ссылки на исходники) — в Git
vpn/bin/*
!vpn/bin/LICENSE-*
!vpn/bin/COPYING-*
!vpn/bin/THIRD_PARTY.md

# инструменты «Декомпилятора» (UPX, pycdc, CFR, собранный sbit-dotnet) — в релиз отдельно;
# исходники sbit-dotnet (tools/dotnet), tools/build_tools.py и THIRD_PARTY.md — в Git
tools/bin/*
!tools/bin/THIRD_PARTY.md
tools/dotnet/bin/
tools/dotnet/obj/

# выгрузка проверок PyCharm
inspections/

# своя база хэшей (удалённые из карантина файлы) — только на этом компьютере
